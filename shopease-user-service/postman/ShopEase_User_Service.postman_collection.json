{
  "info": {
    "name": "ShopEase User Service",
    "description": "Run the whole collection top to bottom with the Collection Runner. The Setup folder registers and logs in two users in the Authentication Service (start it first on auth_url) and stores their JWTs; the other folders test the User Service on user_url. The last requests delete the test profiles so the collection can be run again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - Authentication Service (login belongs to the Auth Service)",
      "item": [
        {
          "name": "Auth - register user A (201, or 409 if it already exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201/409\", function () { pm.expect(pm.response.code === 201 || pm.response.code === 409).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/register",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sai Tej\",\n  \"email\": \"postman.user.a@example.com\",\n  \"password\": \"{{password}}\",\n  \"confirm_password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Auth - login user A (gets the JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.expect(pm.response.code === 200).to.eql(true); });",
                  "pm.test(\"Token received\", function () { pm.expect(pm.response.json().access_token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token_a\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user.a@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
